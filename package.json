{
  "name": "@kaonashi-dev/techne",
  "version": "0.0.1",
  "description": "Techne — a Bun-native application framework built on Elysia with a decorator-first developer experience",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./dist/types/index.d.ts"
    },
    "./common": {
      "bun": "./src/common/index.ts",
      "import": "./src/common/index.ts",
      "types": "./dist/types/common/index.d.ts"
    },
    "./core": {
      "bun": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "types": "./dist/types/core/index.d.ts"
    },
    "./config": {
      "bun": "./src/config/index.ts",
      "import": "./src/config/index.ts",
      "types": "./dist/types/config/index.d.ts"
    },
    "./jwt": {
      "bun": "./src/jwt/index.ts",
      "import": "./src/jwt/index.ts",
      "types": "./dist/types/jwt/index.d.ts"
    },
    "./swagger": {
      "bun": "./src/swagger/index.ts",
      "import": "./src/swagger/index.ts",
      "types": "./dist/types/swagger/index.d.ts"
    },
    "./health": {
      "bun": "./src/health/index.ts",
      "import": "./src/health/index.ts",
      "types": "./dist/types/health/index.d.ts"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "types": "./dist/types/testing/index.d.ts"
    },
    "./cqrs": {
      "bun": "./src/cqrs/index.ts",
      "import": "./src/cqrs/index.ts",
      "types": "./dist/types/cqrs/index.d.ts"
    },
    "./queue": {
      "bun": "./src/queue/index.ts",
      "import": "./src/queue/index.ts",
      "types": "./dist/types/queue/index.d.ts"
    },
    "./mq": {
      "bun": "./src/mq/index.ts",
      "import": "./src/mq/index.ts",
      "types": "./dist/types/mq/index.d.ts"
    },
    "./prisma": {
      "bun": "./src/prisma/index.ts",
      "import": "./src/prisma/index.ts",
      "types": "./dist/types/prisma/index.d.ts"
    },
    "./contract": {
      "bun": "./src/contract/index.ts",
      "import": "./src/contract/index.ts",
      "types": "./dist/types/contract/index.d.ts"
    },
    "./http": {
      "bun": "./src/http/index.ts",
      "import": "./src/http/index.ts",
      "types": "./dist/types/http/index.d.ts"
    },
    "./console": {
      "bun": "./src/console/index.ts",
      "import": "./src/console/index.ts",
      "types": "./dist/types/console/index.d.ts"
    },
    "./security": {
      "bun": "./src/security/index.ts",
      "import": "./src/security/index.ts",
      "types": "./dist/types/security/index.d.ts"
    },
    "./telemetry": {
      "bun": "./src/telemetry/index.ts",
      "import": "./src/telemetry/index.ts",
      "types": "./dist/types/telemetry/index.d.ts"
    }
  },
  "bin": {
    "techne": "src/cli/index.ts"
  },
  "files": [
    "src",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "bun test tests/*.test.ts",
    "test:watch": "bun test --watch tests/*.test.ts",
    "test:nestjs": "bun test tests/nestjs/",
    "check": "bun run lint && bun run format:check",
    "check:fix": "bun run lint:fix && bun run format .",
    "bench": "bun run benchmarks/index.ts",
    "bench:http": "bun run benchmarks/http.ts",
    "bench:socket": "bun run benchmarks/socket.ts",
    "bench:client": "bun run benchmarks/http-client.ts",
    "bench:memory": "bun run benchmarks/memory.ts",
    "bench:quick": "bun run benchmarks/index.ts --quick",
    "bench:ci": "bun run benchmarks/index.ts --quick --skip-socket --skip-memory",
    "bench:check": "bun run scripts/bench-check.ts",
    "bench:compare": "bun run benchmarks/compare.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@prisma/client": "^5",
    "@types/bun": "^1.3.11",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "prisma": "^5"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": ">=0.200.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.200.0",
    "@opentelemetry/resources": ">=2.0.0",
    "@opentelemetry/sdk-metrics": ">=2.0.0",
    "@opentelemetry/sdk-trace-base": ">=2.0.0",
    "@opentelemetry/sdk-trace-node": ">=2.0.0",
    "@opentelemetry/semantic-conventions": ">=1.30.0",
    "@prisma/client": ">=5",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  },
  "dependencies": {
    "elysia": "2.0.0-beta.1",
    "exact-mirror": "^1.2.2",
    "typebox": "^1.3.10"
  }
}
